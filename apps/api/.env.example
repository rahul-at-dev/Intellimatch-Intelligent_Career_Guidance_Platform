# App
DEMO_MODE=true

# Database
DATABASE_URL=postgresql://intellimatch:intellimatch@localhost:5432/intellimatch

# Cache / broker
REDIS_URL=redis://localhost:6379/0

# Vector DB
QDRANT_URL=http://localhost:6333

# Knowledge graph
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=intellimatch

# LLM (OpenRouter API)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=poolside/laguna-s-2.1:free


# GitHub verification (optional — falls back to mock evidence if unset)
GITHUB_TOKEN=

# Object storage (optional — S3-compatible; falls back to local disk if unset)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Auth (Clerk session verification)
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_PUBLISHABLE_KEY=

# Affinda Resume Parser API (https://affinda.com)
AFFINDA_API_KEY=
AFFINDA_WORKSPACE_ID=
AFFINDA_DOCUMENT_TYPE=

# Adzuna Jobs API (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

CORS_ORIGINS=["http://localhost:3000"]
